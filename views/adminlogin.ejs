<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <title>Admin Login | BooksHeaven</title>
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav.ejs') %>
    <main class="relative flex min-h-[calc(100vh-70px)] items-center justify-center overflow-hidden px-4 py-12 sm:px-6">
        <div class="absolute -left-24 top-16 h-64 w-64 rounded-full bg-[#E8DCC7] opacity-50 blur-3xl"></div>
        <div class="absolute -right-24 bottom-8 h-72 w-72 rounded-full bg-[#DCE5ED] opacity-70 blur-3xl"></div>
        <div class="relative grid w-full max-w-5xl overflow-hidden rounded-3xl bg-white login-card md:grid-cols-2">
            <section class="relative hidden flex-col justify-between overflow-hidden bg-[#1E3A5F] p-10 text-white md:flex lg:p-12">
                <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
                <div class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full border border-white/10"></div>
                <div class="relative z-10">
                    <div class="mb-12 flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-2xl">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <div>
                            <h2 class="heading text-2xl font-bold">BooksHeaven</h2>
                            <p class="text-xs tracking-widest text-white/60">YOUR WORLD OF BOOKS</p>
                        </div>
                    </div>
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#F2C879]">Administrator Portal</p>
                    <h1 class="heading max-w-sm text-4xl leading-tight font-semibold lg:text-5xl">
                        Every great story starts with a little magic.
                    </h1>
                    <p class="mt-6 max-w-sm text-sm leading-7 text-white/70">
                        Manage your collection, discover new possibilities and keep your bookstore running smoothly.
                    </p>
                </div>

                <div class="relative z-10 mt-12">
                    <div class="mb-5 flex items-center gap-4">
                        <div class="h-px flex-1 bg-white/20"></div>
                        <i class="fa-solid fa-bookmark text-[#F2C879]"></i>
                        <div class="h-px flex-1 bg-white/20"></div>
                    </div>
                    <p class="heading text-center text-lg italic text-white/80">"A room without books is like a body without a soul."</p>
                    <p class="mt-3 text-center text-xs text-white/50">— Marcus Tullius Cicero</p>
                </div>
            </section>

            <section class="flex items-center justify-center p-6 sm:p-10 lg:p-14">
                <div class="w-full max-w-sm">
                    <div class="mb-8 md:hidden">
                        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#1E3A5F] text-2xl text-white shadow-lg">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <p class="text-sm font-semibold text-[#B77926]">BOOKSHEAVEN</p>
                    </div>

                    <div class="mb-8">
                        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#EEF2F7] text-2xl text-[#1E3A5F]">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <h2 class="heading text-3xl font-bold text-[#1E3A5F] sm:text-4xl">Welcome back</h2>
                        <p class="mt-3 text-sm leading-6 text-gray-500">
                            Sign in to access your admin dashboard and manage your bookstore.
                        </p>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <p class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-center text-sm font-medium text-red-700">
                            <i class="fa-solid fa-circle-exclamation mr-2"></i><%= error %>
                        </p>
                    <% } %>

                    <form action="/admin/login" method="POST" class="space-y-5">
                        <div>
                            <label for="username" class="mb-2 block text-sm font-semibold text-gray-700">Username</label>
                            <div class="input-field flex items-center gap-3 rounded-xl border border-gray-200 bg-[#FCFBF9] px-4 transition">
                                <i class="fa-regular fa-user text-gray-400"></i>
                                <input id="username" type="text" name="username" placeholder="Enter your username" autocomplete="username" required class="w-full bg-transparent py-3.5 text-sm outline-none placeholder:text-gray-400">
                            </div>
                        </div>

                        <div>
                            <div class="mb-2 flex items-center justify-between gap-2">
                                <label for="password" class="block text-sm font-semibold text-gray-700">Password</label>
                                <span class="text-xs text-gray-400"><i class="fa-solid fa-lock mr-1"></i> Secure login</span>
                            </div>
                            <div class="input-field flex items-center gap-3 rounded-xl border border-gray-200 bg-[#FCFBF9] px-4 transition">
                                <i class="fa-solid fa-key text-gray-400"></i>
                                <input id="password" type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required class="w-full bg-transparent py-3.5 text-sm outline-none placeholder:text-gray-400">
                                <button type="button" id="togglePassword" aria-label="Show password" class="text-gray-400 transition hover:text-[#1E3A5F]">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="group flex w-full items-center justify-center gap-3 rounded-xl bg-[#1E3A5F] py-3.5 font-semibold text-white shadow-md shadow-[#1E3A5F]/15 transition duration-300 hover:-translate-y-0.5 hover:bg-[#162E4A] hover:shadow-lg">
                            Sign In to Dashboard
                            <i class="fa-solid fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
                        </button>
                    </form>

                    <div class="my-7 flex items-center gap-4">
                        <div class="h-px flex-1 bg-gray-200"></div>
                        <span class="text-xs text-gray-400">BOOKSHEAVEN ADMIN</span>
                        <div class="h-px flex-1 bg-gray-200"></div>
                    </div>

                    <a href="/" class="flex items-center justify-center gap-2 text-sm font-medium text-gray-500 transition hover:text-[#1E3A5F]">
                        <i class="fa-solid fa-arrow-left text-xs"></i>
                        Back to bookstore
                    </a>

                    <p class="mt-8 text-center text-xs text-gray-400">
                        <i class="fa-solid fa-shield-halved mr-1 text-[#1E3A5F]"></i>
                        Authorized administrators only
                    </p>
                </div>
            </section>
        </div>
    </main>

    <script>
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');

        togglePassword.addEventListener('click', () => {
            const isHidden = password.type === 'password';
            password.type = isHidden ? 'text' : 'password';
            togglePassword.innerHTML = isHidden
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';
            togglePassword.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });
    </script>
</body>
</html>

