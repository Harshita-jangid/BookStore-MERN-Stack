<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Checkout | booksHeaven</title>
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav') %>

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="mb-8">
            <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[#C47A22]">Almost Yours</p>
            <h1 class="text-3xl font-bold text-[#1E3A5F] sm:text-4xl">Checkout</h1>
            <p class="mt-2 text-gray-600">Enter your delivery details to place your order.</p>
        </div>

        <form action="/checkout" method="POST" class="grid gap-8 lg:grid-cols-[1fr_350px]">
            <section class="rounded-2xl border border-[#E5DED2] bg-white p-5 sm:p-8">
                <h2 class="mb-6 text-xl font-bold text-[#1E3A5F]">
                    <i class="fa-solid fa-location-dot mr-2 text-[#C47A22]"></i>Delivery Details
                </h2>

                <% if (error) { %>
                    <p class="mb-5 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"><%= error %></p>
                <% } %>

                <div class="mb-5">
                    <label for="customerName" class="mb-2 block text-sm font-semibold">Full Name</label>
                    <input id="customerName" name="customerName" type="text" required maxlength="100" autocomplete="name" value="<%= formData.customerName || currentUserName || '' %>" class="w-full rounded-xl border border-[#D8D1C5] px-4 py-3 outline-none focus:border-[#1E3A5F]">
                </div>

                <div class="mb-5">
                    <label for="phone" class="mb-2 block text-sm font-semibold">Mobile Number</label>
                    <input id="phone" name="phone" type="tel" required pattern="[6-9][0-9]{9}" maxlength="10" minlength="10" autocomplete="tel" value="<%= formData.phone || '' %>" placeholder="10-digit mobile number" class="w-full rounded-xl border border-[#D8D1C5] px-4 py-3 outline-none focus:border-[#1E3A5F]">
                </div>

                <div class="mb-5">
                    <label for="address" class="mb-2 block text-sm font-semibold">Full Address</label>
                    <textarea id="address" name="address" rows="3" required maxlength="500" autocomplete="street-address" placeholder="House number, street, area..." class="w-full rounded-xl border border-[#D8D1C5] px-4 py-3 outline-none focus:border-[#1E3A5F]"><%= formData.address || '' %></textarea>
                </div>

                <div class="mb-6 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="city" class="mb-2 block text-sm font-semibold">City</label>
                        <input id="city" name="city" type="text" required maxlength="100" autocomplete="address-level2" value="<%= formData.city || '' %>" class="w-full rounded-xl border border-[#D8D1C5] px-4 py-3 outline-none focus:border-[#1E3A5F]">
                    </div>
                    <div>
                        <label for="pincode" class="mb-2 block text-sm font-semibold">PIN Code</label>
                        <input id="pincode" name="pincode" type="text" required pattern="[1-9][0-9]{5}" minlength="6" maxlength="6" inputmode="numeric" autocomplete="postal-code" value="<%= formData.pincode || '' %>" placeholder="6-digit PIN" class="w-full rounded-xl border border-[#D8D1C5] px-4 py-3 outline-none focus:border-[#1E3A5F]">
                    </div>
                </div>

                <h2 class="mb-4 text-xl font-bold text-[#1E3A5F]">
                    <i class="fa-solid fa-wallet mr-2 text-[#C47A22]"></i>Payment Method
                </h2>

                <label class="flex cursor-pointer items-start gap-3 rounded-xl border-2 border-[#1E3A5F] bg-[#F8F5EF] p-4">
                    <input type="radio" name="paymentMethod" value="COD" checked class="mt-1 accent-[#1E3A5F]">
                    <span>
                        <span class="block font-semibold text-[#1E3A5F]">Cash on Delivery</span>
                        <span class="mt-1 block text-sm text-gray-500">Pay when your books arrive.</span>
                    </span>
                    <i class="fa-solid fa-money-bill-wave ml-auto mt-1 text-xl text-[#C47A22]"></i>
                </label>

                <p class="mt-4 text-xs text-gray-500">
                    <i class="fa-solid fa-shield-halved mr-1"></i>Your order details will be saved securely with your order.
                </p>
            </section>

            <aside class="h-fit rounded-2xl border border-[#E5DED2] bg-white p-6">
                <h2 class="text-xl font-bold text-[#1E3A5F]">Order Summary</h2>

                <div class="mt-5 space-y-4">
                    <% cart.forEach(item => { %>
                        <div class="flex items-start gap-3">
                            <div class="min-w-0 flex-1">
                                <p class="font-semibold text-[#1E3A5F]"><%= item.Name %></p>
                                <p class="mt-1 text-sm text-gray-500">Qty: <%= item.quantity %></p>
                            </div>
                            <p class="shrink-0 text-sm font-semibold">₹<%= (item.Price * item.quantity).toFixed(2) %></p>
                        </div>
                    <% }) %>
                </div>

                <div class="my-5 border-t border-dashed border-[#D8D1C5]"></div>

                <div class="flex justify-between text-gray-600">
                    <span>Items</span>
                    <span><%= cart.reduce((sum, item) => sum + item.quantity, 0) %></span>
                </div>

                <div class="mt-4 flex justify-between text-gray-600">
                    <span>Delivery</span>
                    <span class="font-medium text-green-700">Free</span>
                </div>

                <div class="my-5 border-t border-[#E5DED2]"></div>

                <div class="flex justify-between gap-3 text-lg font-bold text-[#1E3A5F]">
                    <span>Total</span>
                    <span>₹<%= total.toFixed(2) %></span>
                </div>

                <button type="submit" class="mt-6 w-full rounded-xl bg-[#1E3A5F] px-5 py-3 font-semibold text-white transition hover:bg-[#162E4A]">
                    Place Order <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>

                <a href="/cart" class="mt-4 block text-center text-sm font-semibold text-[#1E3A5F] hover:text-[#C47A22]">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to Cart
                </a>
            </aside>
        </form>
    </main>
    <%- include('includes/footer') %>
</body>
</html>