<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us - BookStore</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>
  <body class="bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav.ejs') %>

    <section class="py-16 px-5">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <p
              class="text-[#C47A22] font-bold tracking-widest text-sm uppercase"
            >
              Contact booksHeaven.
            </p>
            <h1
              class="text-5xl md:text-6xl font-bold text-[#1E3A5F] leading-tight mt-4"
            >
              Let's Talk About Books.
            </h1>
            <p class="text-gray-600 text-lg leading-relaxed mt-6 max-w-lg">
              Whether you have a question, need help finding a book, or simply
              want to share your reading experience, we're always happy to hear
              from you.
            </p>

            <div class="mt-10 space-y-4">
              <div
                class="flex items-center gap-4 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition"
              >
                <div
                  class="w-12 h-12 flex items-center justify-center bg-[#E8DCC8] rounded-xl text-xl"
                >
                  <i class="fa-solid fa-envelope"></i>
                </div>
                <div>
                  <p class="text-sm text-gray-500">Email</p>
                  <p class="font-semibold text-[#1E3A5F]">
                    booksHeaven@gmail.com
                  </p>
                </div>
              </div>

              <div
                class="flex items-center gap-4 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition"
              >
                <div
                  class="w-12 h-12 flex items-center justify-center bg-[#E8DCC8] rounded-xl text-xl"
                >
                  <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                  <p class="text-sm text-gray-500">Phone</p>
                  <p class="font-semibold text-[#1E3A5F]">+91 98765 43210</p>
                </div>
              </div>

              <div
                class="flex items-center gap-4 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition"
              >
                <div
                  class="w-12 h-12 flex items-center justify-center bg-[#E8DCC8] rounded-xl text-xl"
                >
                  <i class="fa-solid fa-map-marker-alt"></i>
                </div>
                <div>
                  <p class="text-sm text-gray-500">Location</p>
                  <p class="font-semibold text-[#1E3A5F]">
                    Jaipur, Rajasthan, India
                  </p>
                </div>
              </div>
            </div>

            <div
              class="mt-8 inline-flex items-center gap-3 bg-[#1E3A5F] text-white px-5 py-3 rounded-full"
            >
              <span class="text-sm font-medium"
                >Every question deserves an answer.</span
              >
            </div>
          </div>

          <div class="bg-white rounded-3xl shadow-xl p-8 md:p-10">
            <div class="mb-8">
              <h2 class="text-3xl font-bold text-[#1E3A5F] mt-5">
                Send a Message
              </h2>
              <p class="text-gray-500 mt-2">We'd love to hear from you.</p>
            </div>
            <form action="/contact" method="post" class="space-y-5">
              <div>
                <label
                  for="name"
                  class="block text-sm font-semibold text-gray-700 mb-2"
                  >Full Name</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Your full name"
                  required
                  class="w-full px-4 py-3.5 bg-[#F8F5EF] border border-transparent rounded-xl outline-none focus:bg-white focus:border-[#1E3A5F] focus:ring-2 focus:ring-blue-100 transition"
                />
              </div>
              <div>
                <label
                  for="email"
                  class="block text-sm font-semibold text-gray-700 mb-2"
                  >Email Address</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="your@email.com"
                  required
                  class="w-full px-4 py-3.5 bg-[#F8F5EF] border border-transparent rounded-xl outline-none focus:bg-white focus:border-[#1E3A5F] focus:ring-2 focus:ring-blue-100 transition"
                />
              </div>
              <div>
                <label
                  for="mob"
                  class="block text-sm font-semibold text-gray-700 mb-2"
                  >Phone Number</label
                >
                <input
                  type="tel"
                  id="mob"
                  name="mob"
                  placeholder="+91 XXXXX XXXXX"
                  required
                  class="w-full px-4 py-3.5 bg-[#F8F5EF] border border-transparent rounded-xl outline-none focus:bg-white focus:border-[#1E3A5F] focus:ring-2 focus:ring-blue-100 transition"
                />
              </div>
              <div>
                <label
                  for="message"
                  class="block text-sm font-semibold text-gray-700 mb-2"
                  >Your Message</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Tell us what you're looking for..."
                  required
                  class="w-full px-4 py-3.5 bg-[#F8F5EF] border border-transparent rounded-xl outline-none resize-none focus:bg-white focus:border-[#1E3A5F] focus:ring-2 focus:ring-blue-100 transition"
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full bg-[#1E3A5F] hover:bg-[#162D49] text-white font-semibold py-4 rounded-xl transition duration-300 hover:shadow-lg"
              >
                Send Message <span class="ml-2">→</span>
              </button>
              <% if (success) { %>
    <div class="mb-5 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
        <i class="fa-solid fa-circle-check mr-2"></i>
        Your message has been sent successfully!
    </div>
<% } %>
            </form>
          </div>
        </div>
        <div
          class="mt-16 bg-[#1E3A5F] rounded-3xl px-8 py-10 md:px-12 md:py-12 text-center"
        >
          <p class="text-[#F59E0B] font-bold text-sm tracking-widest">
            BOOK LOVERS WELCOME
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-white mt-3">
            Have a Story to Share?
          </h2>
          <p class="text-blue-200 max-w-2xl mx-auto mt-4">
            Your feedback, suggestions and ideas help us make booksHeaven a
            better place for every reader.
          </p>
          <div class="flex justify-center gap-3 mt-6">
            <span class="bg-white/10 text-white px-4 py-2 rounded-full text-sm"
              >Readers</span
            >
            <span class="bg-white/10 text-white px-4 py-2 rounded-full text-sm"
              >Ideas</span
            >
            <span class="bg-white/10 text-white px-4 py-2 rounded-full text-sm"
              >Feedback</span
            >
          </div>
        </div>
      </div>
    </section>

    <%- include('includes/footer.ejs') %>
  </body>
</html>
