<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Book - BookStore</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav.ejs') %>
    <section class="py-16 px-5">
      <div class="max-w-xl mx-auto">
        <div class="text-center mb-8">
          <p
            class="text-[#C47A22] font-semibold text-sm tracking-widest uppercase mt-5"
          >
            Book Collection
          </p>
          <h1 class="text-4xl font-bold text-[#1E3A5F] mt-2">Add a New Book</h1>
          <p class="text-gray-500 mt-3">
            Add the details of a new book to your collection.
          </p>
        </div>
        <form
          action="/books"
          method="post"
          enctype="multipart/form-data"
          class="bg-white rounded-2xl p-7 md:p-9 shadow-lg border border-[#E5E0D8]"
        >
          <div class="space-y-5">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Book Name</label
              >
              <input
                type="text"
                name="Name"
                placeholder="Enter book name"
                required
                class="w-full px-4 py-3 bg-[#F8F5EF] border border-[#E1DDD5] rounded-lg outline-none focus:border-[#1E3A5F] focus:bg-white transition"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Author</label
              >
              <input
                type="text"
                name="Author"
                placeholder="Enter author name"
                required
                class="w-full px-4 py-3 bg-[#F8F5EF] border border-[#E1DDD5] rounded-lg outline-none focus:border-[#1E3A5F] focus:bg-white transition"
              />
            </div>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Price</label
                >
                <div class="relative">
                  <span
                    class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"
                    >₹</span
                  >
                  <input
                    type="number"
                    name="Price"
                    placeholder="Book price"
                    required
                    class="w-full pl-9 pr-4 py-3 bg-[#F8F5EF] border border-[#E1DDD5] rounded-lg outline-none focus:border-[#1E3A5F] focus:bg-white transition"
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Category</label
                >
                <input
                  type="text"
                  name="Category"
                  placeholder="e.g. Fiction"
                  required
                  class="w-full px-4 py-3 bg-[#F8F5EF] border border-[#E1DDD5] rounded-lg outline-none focus:border-[#1E3A5F] focus:bg-white transition"
                />
              </div>
            </div>
            <div>
              <label
                for="Description"
                class="mb-2 block font-semibold text-[#1E3A5F]"
                >Book Description</label
              >
              <textarea
                id="Description"
                name="Description"
                rows="5"
                placeholder="Enter book description..."
                class="w-full rounded-xl border border-[#D8D1C5] p-3 outline-none focus:border-[#C47A22]"
              ></textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Book Image</label
              >
              <label
                class="flex items-center gap-4 px-4 py-4 bg-[#F8F5EF] border border-dashed border-[#C9C4BA] rounded-lg cursor-pointer hover:border-[#1E3A5F] transition"
              >
                <span class="text-2xl">🖼️</span>
                <div>
                  <p class="text-sm font-semibold text-[#1E3A5F]">
                    Choose book cover
                  </p>
                  <p class="text-xs text-gray-500">PNG, JPG or JPEG</p>
                </div>
                <input
                  type="file"
                  name="img"
                  accept="image/*"
                  required
                  class="hidden"
                />
              </label>
            </div>
            <div class="pt-2">
              <button
                type="submit"
                class="w-full bg-[#1E3A5F] hover:bg-[#162D49] text-white font-semibold py-3.5 rounded-lg transition hover:shadow-md"
              >
                Add Book →
              </button>
            </div>
          </div>
        </form>
        <p class="text-center text-sm text-gray-400 mt-6">
          Add a book and make it part of your reading collection.
        </p>
      </div>
    </section>
    <%- include('includes/footer.ejs') %>
  </body>
</html>
