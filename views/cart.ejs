<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart | booksHeaven</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav') %>
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="mb-8">
            <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[#C47A22]">Your Shopping Bag</p>
            <h1 class="text-3xl font-bold text-[#1E3A5F] sm:text-4xl">My Cart</h1>
            <p class="mt-2 text-gray-600">Review your selected books before checkout.</p>
        </div>
        <% if (cart.length === 0) { %>
            <div class="rounded-2xl border border-[#E5DED2] bg-white px-6 py-16 text-center">
                <i class="fa-solid fa-basket-shopping mb-5 text-5xl text-[#C47A22]"></i>
                <h2 class="text-2xl font-bold text-[#1E3A5F]">Your cart is empty</h2>
                <p class="mt-3 text-gray-500">Looks like you haven't added any books yet.</p>
                <a href="/books" class="mt-6 inline-block rounded-xl bg-[#1E3A5F] px-6 py-3 font-semibold text-white transition hover:bg-[#162E4A]">Explore Books</a>
            </div>
        <% } else { %>
            <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
                <div class="space-y-4">
                    <% cart.forEach(item => { %>
                        <div class="flex flex-col gap-4 rounded-2xl border border-[#E5DED2] bg-white p-4 sm:flex-row sm:items-center">
                            <div class="flex h-28 w-full shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[#F8F5EF] sm:w-24">
                                <% if (item.img) { %>
                                    <img src="<%= item.img %>" alt="<%= item.Name %>" class="h-full w-full object-contain p-2">
                                <% } else { %>
                                    <i class="fa-solid fa-book-open text-3xl text-[#C47A22]"></i>
                                <% } %>
                            </div>
                            <div class="min-w-0 flex-1">
                                <h2 class="text-lg font-bold text-[#1E3A5F]"><%= item.Name %></h2>
                                <p class="mt-1 text-sm text-gray-500">By <%= item.Author || 'Unknown Author' %></p>
                                <p class="mt-3 font-semibold text-[#C47A22]">₹<%= item.Price.toFixed(2) %></p>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-4 sm:justify-end">
                                <form action="/cart/update/<%= item.bookId %>" method="POST" class="flex items-center gap-2">
                                    <label for="qty-<%= item.bookId %>" class="text-sm text-gray-500">Qty</label>
                                    <input id="qty-<%= item.bookId %>" type="number" name="quantity" value="<%= item.quantity %>" min="1" max="99" required class="w-16 rounded-lg border border-[#D8D1C5] px-2 py-2 text-center outline-none focus:border-[#C47A22]">
                                    <button type="submit" aria-label="Update quantity" title="Update quantity" class="rounded-lg border border-[#D8D1C5] px-3 py-2 text-[#1E3A5F] hover:bg-[#F8F5EF]">
                                        <i class="fa-solid fa-rotate"></i>
                                    </button>
                                </form>
                                <p class="font-bold text-[#1E3A5F]">₹<%= (item.Price * item.quantity).toFixed(2) %></p>
                                <form action="/cart/remove/<%= item.bookId %>" method="POST">
                                    <button type="submit" class="rounded-lg px-3 py-2 text-red-600 hover:bg-red-50">
                                        <i class="fa-regular fa-trash-can mr-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                    <a href="/books" class="inline-flex items-center gap-2 py-3 font-semibold text-[#1E3A5F] hover:text-[#C47A22]">
                        <i class="fa-solid fa-arrow-left"></i>Continue Shopping
                    </a>
                </div>
                <aside class="h-fit rounded-2xl border border-[#E5DED2] bg-white p-6">
                    <h2 class="text-xl font-bold text-[#1E3A5F]">Order Summary</h2>
                    <div class="mt-6 flex justify-between gap-3 text-gray-600">
                        <span>Items</span>
                        <span><%= cart.reduce((sum, item) => sum + item.quantity, 0) %></span>
                    </div>
                    <div class="mt-4 flex justify-between gap-3 text-gray-600">
                        <span>Subtotal</span>
                        <span>₹<%= total.toFixed(2) %></span>
                    </div>
                    <div class="my-5 border-t border-dashed border-[#D8D1C5]"></div>
                    <div class="flex justify-between gap-3 text-lg font-bold text-[#1E3A5F]">
                        <span>Total</span>
                        <span>₹<%= total.toFixed(2) %></span>
                    </div>
                    <a href="/checkout" class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1E3A5F] px-5 py-3 font-semibold text-white transition hover:bg-[#162E4A]">Proceed to Checkout<i class="fa-solid fa-arrow-right"></i></a>
                    <p class="mt-3 text-center text-xs text-gray-500">Your selected books are listed above.</p>
                </aside>
            </div>
        <% } %>
    </main>
    <%- include('includes/footer') %>
</body>
</html>