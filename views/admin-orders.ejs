<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Manage Orders | booksHeaven</title>
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav') %>
    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[#C47A22]">Store Management</p>
                <h1 class="text-3xl font-bold text-[#1E3A5F] sm:text-4xl">Customer Orders</h1>
                <p class="mt-2 text-gray-600">View orders and manage their delivery status.</p>
            </div>
            <a href="/admin/orders" class="rounded-xl border border-[#D8D1C5] bg-white px-4 py-3 font-semibold text-[#1E3A5F] hover:bg-[#F8F5EF]">
                <i class="fa-solid fa-rotate-right mr-2"></i>Refresh
            </a>
        </div>

        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-[#E5DED2] bg-white p-5">
                <p class="text-sm text-gray-500">Total Orders</p>
                <p class="mt-2 text-3xl font-bold text-[#1E3A5F]"><%= orders.length %></p>
            </div>
            <div class="rounded-2xl border border-[#E5DED2] bg-white p-5">
                <p class="text-sm text-gray-500">New / Placed Orders</p>
                <p class="mt-2 text-3xl font-bold text-[#C47A22]"><%= orders.filter(order => order.orderStatus === 'Placed').length %></p>
            </div>
            <div class="rounded-2xl border border-[#E5DED2] bg-white p-5">
                <p class="text-sm text-gray-500">Delivered Orders</p>
                <p class="mt-2 text-3xl font-bold text-green-700"><%= orders.filter(order => order.orderStatus === 'Delivered').length %></p>
            </div>
        </div>

        <% if (orders.length === 0) { %>
            <div class="rounded-2xl border border-[#E5DED2] bg-white px-6 py-16 text-center">
                <i class="fa-solid fa-box-open mb-5 text-5xl text-[#C47A22]"></i>
                <h2 class="text-2xl font-bold text-[#1E3A5F]">No Orders Yet</h2>
                <p class="mt-3 text-gray-500">Customer orders will appear here.</p>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% orders.forEach(order => { %>
                    <section class="overflow-hidden rounded-2xl border border-[#E5DED2] bg-white shadow-sm">
                        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#E5DED2] bg-[#FCFAF6] p-5">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Order ID</p>
                                <p class="mt-1 break-all font-bold text-[#1E3A5F]"><%= order._id %></p>
                                <p class="mt-2 text-sm text-gray-500"><%= new Date(order.createdAt).toLocaleString('en-IN') %></p>
                            </div>
                            <span class="rounded-full bg-amber-100 px-3 py-1.5 text-sm font-semibold text-amber-800"><%= order.orderStatus %></span>
                        </div>

                        <div class="grid gap-6 p-5 md:grid-cols-2">
                            <div>
                                <h3 class="mb-3 font-bold text-[#1E3A5F]"><i class="fa-solid fa-user mr-2 text-[#C47A22]"></i>Customer Details</h3>
                                <p class="font-semibold"><%= order.customerName %></p>
                                <p class="mt-1 text-sm text-gray-600"><%= order.phone %></p>
                                <p class="mt-1 text-sm text-gray-600"><%= order.address %>, <%= order.city %> - <%= order.pincode %></p>
                                <div class="mt-4">
                                    <p class="text-sm text-gray-500">Payment Method</p>
                                    <p class="mt-1 font-semibold"><%= order.paymentMethod %></p>
                                    <p class="mt-2 text-sm text-gray-500">Payment Status: <span class="font-semibold text-amber-700"><%= order.paymentStatus %></span></p>
                                </div>
                            </div>

                            <div>
                                <h3 class="mb-3 font-bold text-[#1E3A5F]"><i class="fa-solid fa-book-open mr-2 text-[#C47A22]"></i>Ordered Books</h3>
                                <div class="space-y-3">
                                    <% order.items.forEach(item => { %>
                                        <div class="flex justify-between gap-3 border-b border-[#F0EBE2] pb-3">
                                            <div>
                                                <p class="font-semibold"><%= item.name %></p>
                                                <p class="mt-1 text-sm text-gray-500">Qty: <%= item.quantity %> × ₹<%= Number(item.price).toFixed(2) %></p>
                                            </div>
                                            <p class="shrink-0 font-semibold text-[#1E3A5F]">₹<%= (item.price * item.quantity).toFixed(2) %></p>
                                        </div>
                                    <% }) %>
                                </div>
                                <div class="mt-4 flex justify-between text-lg font-bold text-[#1E3A5F]">
                                    <span>Order Total</span>
                                    <span>₹<%= order.totalAmount.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>

                        <form action="/admin/orders/<%= order._id %>/status" method="POST" class="flex flex-col gap-3 border-t border-[#E5DED2] bg-[#FCFAF6] p-5 sm:flex-row sm:items-center">
                            <label for="status-<%= order._id %>" class="text-sm font-semibold text-[#1E3A5F]">Update Order Status</label>
                            <select id="status-<%= order._id %>" name="orderStatus" class="rounded-xl border border-[#D8D1C5] bg-white px-3 py-2 outline-none focus:border-[#1E3A5F]">
                                <% ['Placed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'].forEach(status => { %>
                                    <option value="<%= status %>" <%= order.orderStatus === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                            <button type="submit" class="rounded-xl bg-[#1E3A5F] px-5 py-2.5 font-semibold text-white hover:bg-[#162E4A]">
                                Save Status
                            </button>
                        </form>
                    </section>
                <% }) %>
            </div>
        <% } %>
    </main>

    <%- include('includes/footer') %>
</body>
</html>