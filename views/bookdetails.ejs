<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= book.Name %> | booksHeaven</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav') %>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
        <a href="/books" class="mb-8 inline-flex items-center gap-2 font-medium text-[#1E3A5F] transition hover:text-[#C47A22]">
            <i class="fa-solid fa-arrow-left"></i> Back to Books
        </a>
        <div class="mt-6 grid gap-8 rounded-3xl border border-[#E5DED2] bg-white p-5 shadow-sm sm:p-8 lg:grid-cols-2 lg:gap-12 lg:p-10">
            <div class="flex min-h-[320px] items-center justify-center rounded-2xl bg-[#F8F5EF] p-6 sm:min-h-[450px]">
                <% if (book.img) { %>
                    <img src="<%= book.img.startsWith('/uploads/') ? book.image : '/uploads/' + book.image %>" alt="<%= book.Name %>" class="max-h-[420px] w-full object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                    <div class="hidden h-72 w-full items-center justify-center">
                        <i class="fa-solid fa-book-open text-7xl text-[#C47A22]"></i>
                    </div>
                <% } else { %>
                    <i class="fa-solid fa-book-open text-7xl text-[#C47A22]"></i>
                <% } %>
            </div>
            <div class="flex flex-col justify-center py-2">
                <span class="mb-4 w-fit rounded-full bg-[#F8F5EF] px-4 py-2 text-sm font-semibold text-[#C47A22]">
                    <i class="fa-solid fa-bookmark mr-2"></i><%= book.Category || 'General' %>
                </span>
                <h1 class="text-3xl font-bold leading-tight text-[#1E3A5F] sm:text-4xl">
                    <%= book.Name %>
                </h1>
                <p class="mt-3 text-gray-500">
                    <i class="fa-solid fa-user-pen mr-2 text-[#C47A22]"></i>
                    By <%= book.Author || 'Unknown Author' %>
                </p>
                <div class="my-6 border-t border-[#E5DED2]"></div>
                <p class="text-sm font-semibold uppercase tracking-wider text-gray-500">Price</p>
                <p class="mt-2 text-3xl font-bold text-[#C47A22]">₹<%= Number(book.Price || 0).toFixed(2) %></p>
                <div class="mt-7">
                    <h2 class="text-lg font-bold text-[#1E3A5F]">About This Book</h2>
                    <p class="mt-3 whitespace-pre-line text-sm leading-7 text-gray-600 sm:text-base"><%= book.Description || 'Discover this book and add it to your reading collection. More information about this title will be available soon.' %></p>
                </div>
                <div class="my-6 border-t border-[#E5DED2]"></div>
                <form action="/cart/add/<%= book._id %>" method="POST" class="space-y-5">
                    <div>
                        <label for="quantity" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Quantity</label>
                        <input id="quantity" type="number" name="quantity" value="1" min="1" max="99" required class="w-24 rounded-xl border border-[#D8D1C5] bg-white px-4 py-3 outline-none transition focus:border-[#C47A22] focus:ring-2 focus:ring-[#C47A22]/20">
                    </div>
                    <button type="submit" class="flex w-full items-center justify-center gap-3 rounded-xl bg-[#1E3A5F] px-6 py-4 font-semibold text-white transition hover:bg-[#162E4A] sm:w-auto">
                        <i class="fa-solid fa-cart-plus"></i>Add to Cart
                    </button>
                </form>
                <div class="mt-6 grid gap-3 border-t border-[#E5DED2] pt-5 text-sm text-gray-600 sm:grid-cols-2">
                    <p><i class="fa-solid fa-shield-halved mr-2 text-[#C47A22]"></i>Easy shopping</p>
                    <p><i class="fa-solid fa-book-open mr-2 text-[#C47A22]"></i>Made for readers</p>
                </div>
            </div>
        </div>
        <div class="mt-8 rounded-2xl border border-[#E5DED2] bg-white p-6 sm:p-8">
            <h2 class="text-xl font-bold text-[#1E3A5F]">Find Your Next Read</h2>
            <p class="mt-2 text-gray-600">Explore more books and discover your next favourite story.</p>
            <a href="/books" class="mt-5 inline-flex items-center gap-2 font-semibold text-[#C47A22] transition hover:text-[#1E3A5F]">
                Browse All Books <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </main>
    <%- include('includes/footer') %>
</body>
</html>