
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Order Confirmed | booksHeaven</title>
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav') %>
    <main class="mx-auto flex max-w-2xl flex-col items-center px-4 py-16 text-center">
        <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-green-100 text-4xl text-green-700">
            <i class="fa-solid fa-check"></i>
        </div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-[#C47A22]">Thank You For Shopping</p>
        <h1 class="text-3xl font-bold text-[#1E3A5F] sm:text-4xl">Order Placed Successfully!</h1>
        <p class="mt-4 text-gray-600">Thank you, <%= order.customerName %>. Your books are on their way to becoming part of your story.</p>
        <div class="mt-8 w-full rounded-2xl border border-[#E5DED2] bg-white p-6 text-left shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#E5DED2] pb-4">
                <div>
                    <p class="text-sm text-gray-500">Order ID</p>
                    <p class="mt-1 break-all font-bold text-[#1E3A5F]"><%= order._id %></p>
                </div>
                <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800"><%= order.orderStatus %></span>
            </div>

            <div class="space-y-3 py-5">
                <% order.items.forEach(item => { %>
                    <div class="flex justify-between gap-4">
                        <div>
                            <p class="font-semibold text-[#1E3A5F]"><%= item.name %></p>
                            <p class="text-sm text-gray-500">Quantity: <%= item.quantity %></p>
                        </div>
                        <p class="shrink-0 font-medium">₹<%= (item.price * item.quantity).toFixed(2) %></p>
                    </div>
                <% }) %>
            </div>

            <div class="border-t border-[#E5DED2] pt-4">
                <div class="flex justify-between gap-3">
                    <span class="text-gray-600">Payment Method</span>
                    <span class="font-semibold">Cash on Delivery</span>
                </div>
                <div class="mt-3 flex justify-between gap-3">
                    <span class="text-gray-600">Payment Status</span>
                    <span class="font-semibold text-amber-700"><%= order.paymentStatus %></span>
                </div>
                <div class="mt-4 flex justify-between gap-3 text-lg font-bold text-[#1E3A5F]">
                    <span>Total Amount</span>
                    <span>₹<%= order.totalAmount.toFixed(2) %></span>
                </div>
            </div>

            <div class="mt-5 rounded-xl bg-[#F8F5EF] p-4 text-sm text-gray-600">
                <p class="font-semibold text-[#1E3A5F]">Delivery Address</p>
                <p class="mt-1"><%= order.address %>, <%= order.city %> - <%= order.pincode %></p>
                <p class="mt-1">Phone: <%= order.phone %></p>
            </div>
        </div>

        <a href="/books" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-[#1E3A5F] px-6 py-3 font-semibold text-white transition hover:bg-[#162E4A]">
            <i class="fa-solid fa-book-open"></i> Continue Shopping
        </a>
    </main>

    <%- include('includes/footer') %>
</body>
</html>