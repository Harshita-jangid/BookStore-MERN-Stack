<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Edit Book | booksHeaven</title>
</head>
<body class="min-h-screen bg-[#F8F5EF] text-[#1F2937]">
    <%- include('includes/nav.ejs') %>

    <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
        <div class="mb-8 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#1E3A5F] text-xl text-white shadow-md">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <h1 class="font-serif text-3xl font-bold text-[#1E3A5F] sm:text-4xl">Edit Book</h1>
            <p class="mt-2 text-sm text-gray-500">Update your book details and cover image.</p>
        </div>

        <form action="/books/edit/<%= book._id %>" method="POST" enctype="multipart/form-data" class="rounded-2xl border border-[#E3DED5] bg-white p-5 shadow-sm sm:p-8">
            <div class="mb-5">
                <label for="Name" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Book Name</label>
                <input type="text" id="Name" name="Name" value="<%= book.Name %>" required maxlength="150" placeholder="Enter book name" class="w-full rounded-xl border border-[#E3DED5] bg-[#FDFCFA] px-4 py-3 outline-none transition focus:border-[#1E3A5F] focus:ring-2 focus:ring-[#1E3A5F]/10">
            </div>

            <div class="mb-5">
                <label for="Author" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Author</label>
                <input type="text" id="Author" name="Author" value="<%= book.Author %>" required maxlength="100" placeholder="Enter author name" class="w-full rounded-xl border border-[#E3DED5] bg-[#FDFCFA] px-4 py-3 outline-none transition focus:border-[#1E3A5F] focus:ring-2 focus:ring-[#1E3A5F]/10">
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div class="mb-5">
                    <label for="Price" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Price (₹)</label>
                    <input type="number" id="Price" name="Price" value="<%= book.Price %>" required min="0" step="0.01" placeholder="Enter price" class="w-full rounded-xl border border-[#E3DED5] bg-[#FDFCFA] px-4 py-3 outline-none transition focus:border-[#1E3A5F] focus:ring-2 focus:ring-[#1E3A5F]/10">
                </div>

                <div class="mb-5">
                    <label for="Category" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Category</label>
                    <input type="text" id="Category" name="Category" value="<%= book.Category %>" required maxlength="80" placeholder="e.g. Fiction" class="w-full rounded-xl border border-[#E3DED5] bg-[#FDFCFA] px-4 py-3 outline-none transition focus:border-[#1E3A5F] focus:ring-2 focus:ring-[#1E3A5F]/10">
                </div>
            </div>

            <div class="mb-6">
                <label for="Description" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Book Description</label>
                <textarea id="Description" name="Description" rows="5" maxlength="3000" placeholder="Write a short description about this book..." class="w-full resize-y rounded-xl border border-[#E3DED5] bg-[#FDFCFA] px-4 py-3 outline-none transition focus:border-[#1E3A5F] focus:ring-2 focus:ring-[#1E3A5F]/10"><%= book.Description || '' %></textarea>
            </div>

            <div class="mb-6">
                <label class="mb-3 block text-sm font-semibold text-[#1E3A5F]">Current Book Cover</label>
                <% if (book.img) { %>
                    <div class="flex items-center gap-4 rounded-xl border border-[#E3DED5] bg-[#F8F5EF] p-4">
                        <img src="<%= book.img %>" alt="<%= book.Name %>" class="h-32 w-24 rounded-lg border border-[#E3DED5] bg-white object-contain p-1" onerror="this.style.display='none'">
                        <div>
                            <p class="font-semibold text-[#1E3A5F]"><%= book.Name %></p>
                            <p class="mt-1 text-sm text-gray-500">Current cover image</p>
                        </div>
                    </div>
                <% } else { %>
                    <p class="rounded-xl bg-[#F8F5EF] p-4 text-sm text-gray-500">No cover image available.</p>
                <% } %>
            </div>

            <div class="mb-8">
                <label for="img" class="mb-2 block text-sm font-semibold text-[#1E3A5F]">Upload New Cover</label>
                <input type="file" id="img" name="img" accept="image/*" class="w-full rounded-xl border border-[#E3DED5] bg-[#FDFCFA] p-3 text-sm file:mr-4 file:rounded-lg file:border-0 file:bg-[#1E3A5F] file:px-4 file:py-2 file:font-medium file:text-white hover:file:bg-[#162E4A]">
                <p class="mt-2 text-xs text-gray-500">Choose a new image only if you want to replace the current cover.</p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row">
                <button type="submit" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#1E3A5F] px-5 py-3 font-semibold text-white transition hover:bg-[#162E4A]">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Update Book
                </button>
                <a href="/books" class="flex items-center justify-center gap-2 rounded-xl border border-[#E3DED5] px-5 py-3 font-semibold text-[#1E3A5F] transition hover:bg-[#F8F5EF]">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Books
                </a>
            </div>
        </form>
    </main>
</body>
</html>
