app.post('/checkout', async (req, res) => {
    const cart = req.session.cart || [];
    const formData = req.body;

    const renderCheckout = (message, status = 400) => {
        const total = cart.reduce((sum, item) => {
            return sum +
                (Number(item.price) || 0) *
                (Number(item.quantity) || 1);
        }, 0);

        return res.status(status).render('checkout.ejs', {
            cart,
            total,
            error: message,
            formData,
            currentUserName: ''
        });
    };

    try {
        if (cart.length === 0) {
            return res.redirect('/cart');
        }

        const {
            fullName,
            email,
            phone,
            address,
            city,
            state,
            pincode,
            paymentMethod
        } = req.body;

        if (
            !fullName?.trim() ||
            !email?.trim() ||
            !phone?.trim() ||
            !address?.trim() ||
            !city?.trim() ||
            !state?.trim() ||
            !pincode?.trim()
        ) {
            return renderCheckout('Please fill in all required details.');
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
            return renderCheckout('Please enter a valid email address.');
        }

        if (!/^[6-9]\d{9}$/.test(phone.trim())) {
            return renderCheckout('Please enter a valid 10-digit mobile number.');
        }

        if (!/^[1-9]\d{5}$/.test(pincode.trim())) {
            return renderCheckout('Please enter a valid 6-digit PIN code.');
        }

        if (paymentMethod !== 'Cash on Delivery') {
            return renderCheckout('Please select a valid payment method.');
        }

        const totalAmount = cart.reduce((sum, item) => {
            return sum +
                (Number(item.price) || 0) *
                (Number(item.quantity) || 1);
        }, 0);

        const totalBooks = cart.reduce((sum, item) => {
            return sum + Number(item.quantity || 1);
        }, 0);

        const orderDetails = cart.map((item, index) => {
            const quantity = Number(item.quantity) || 1;
            const price = Number(item.price) || 0;

            return `${index + 1}. ${item.title}
Quantity: ${quantity}
Price per book: Rs. ${price.toFixed(2)}
Subtotal: Rs. ${(price * quantity).toFixed(2)}`;
        }).join('\n\n');

        const mailText = `
NEW BOOK ORDER

CUSTOMER DETAILS
Name: ${fullName.trim()}
Email: ${email.trim()}
Mobile: ${phone.trim()}

DELIVERY ADDRESS
${address.trim()}
${city.trim()}, ${state.trim()}
PIN Code: ${pincode.trim()}

ORDER DETAILS
${orderDetails}

Total Books: ${totalBooks}
Shipping: Free
Grand Total: Rs. ${totalAmount.toFixed(2)}

Payment Method: Cash on Delivery
`;
        await transport.sendMail({
            from: 'harshitaverma2176@gmail.com',
            to: 'harshitaverma2176@gmail.com',
            replyTo: email.trim(),
            subject: 'New Book Order - The Book Store',
            text: mailText
        });

        const order = {
            fullName: fullName.trim(),
            email: email.trim(),
            phone: phone.trim(),
            address: address.trim(),
            city: city.trim(),
            state: state.trim(),
            pincode: pincode.trim(),
            paymentMethod: 'Cash on Delivery',

            items: cart.map(item => ({
                title: item.title,
                price: Number(item.price) || 0,
                quantity: Number(item.quantity) || 1,
                image: item.image
            })),

            totalBooks,
            totalAmount
        };
        req.session.cart = [];

        return res.render('order-success.ejs', { order });

    } catch (err) {
        console.error('Checkout error:', err);

        return renderCheckout(
            'We could not process your order. Please check your connection and try again.',
            500
        );
    }
});


app.post('/cart/add/:id', async (req, res) => {
    try {
        const book = await Book.findById(req.params.id);

        if (!book) {
            return res.status(404).send('Book not found');
        }

        if (!req.session.cart) {
            req.session.cart = [];
        }

        const existingBook = req.session.cart.find(
            item => item.bookId === book._id.toString()
        );

        if (existingBook) {
            existingBook.quantity += 1;
        } else {
            req.session.cart.push({
                bookId: book._id.toString(),
                title: book.title,
                price: book.price,
                image: book.image,
                quantity: 1
            });
        }

        res.redirect('/cart');

    } catch (error) {
        console.error(error);
        res.status(500).send('Unable to add book to cart');
    }
});


